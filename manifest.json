{
  "manifest_version": 3,
  "name": "MoonlightFP",
  "version": "0.9.0",
  "description": "Раздел MoonlightFP внутри FunPay: оформление, автоподнятие и статистика заказов.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": ["https://funpay.com/*"],
  "action": {
    "default_title": "MoonlightFP",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://funpay.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
